{
  "name": "line-ai-secretary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "RUN_DB_TESTS=1 vitest run tests/integration.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "dry-run": "tsx scripts/dry-run.ts",
    "ops": "tsx scripts/operations.ts",
    "infra:plan": "tsx scripts/scheduler-plan.ts",
    "format": "prettier --write src tests scripts package.json tsconfig*.json infra/schedules.json",
    "format:check": "prettier --check src tests scripts package.json tsconfig*.json infra/schedules.json"
  },
  "dependencies": {
    "@google-cloud/tasks": "^7.3.1",
    "@line/bot-sdk": "^11.4.0",
    "@prisma/client": "^6.19.3",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8",
    "google-auth-library": "^11.3.3",
    "googleapis": "^189.0.0",
    "luxon": "^3.7.2",
    "openai": "^7.47.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
